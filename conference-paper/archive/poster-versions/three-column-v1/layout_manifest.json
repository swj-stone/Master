    },
    {
      "text": "01",
      "x": 96,
      "y": 826,
      "width": 106,
      "height": 61.5,
      "font_size": 50
    },
    {
      "text": "THE PROBLEM",
      "x": 211,
      "y": 826,
      "width": 921.5249343832022,
      "height": 61.5,
      "font_size": 50
    },
    {
      "text": "Averages can hide<br/>a harmful context.",
      "x": 96,
      "y": 939,
      "width": 1036.5249343832022,
      "height": 110,
      "font_size": 47
    },
    {
      "text": "Adding a feature can turn an acceptable model into an unacceptable one in a particular coalition.",
      "x": 96,
      "y": 1075,
      "width": 1036.5249343832022,
      "height": 98,
      "font_size": 39
    },
    {
      "text": "ONE COALITION, ONE HARMFUL WITNESS",
      "x": 126,
      "y": 1272,
      "width": 976.5249343832022,
      "height": 38.13,
      "font_size": 31
    },
    {
      "text": "Acceptable",
      "x": 126,
      "y": 1355,
      "width": 325,
      "height": 41.82,
      "font_size": 34
    },
    {
      "text": "v(S) = 1",
      "x": 126,
      "y": 1404,
      "width": 325,
      "height": 49.2,
      "font_size": 40
    },
    {
      "text": "Unacceptable",
      "x": 777.5249343832022,
      "y": 1355,
      "width": 325,
      "height": 41.82,
      "font_size": 34
    },
    {
      "text": "v(S <font name=\"PosterMath\">∪</font> {i}) = 0",
      "x": 777.5249343832022,
      "y": 1404,
      "width": 325,
      "height": 43.05,
      "font_size": 35
    },
    {
      "text": "+ feature i",
      "x": 452,
      "y": 1357,
      "width": 324.5249343832022,
      "height": 39.36,
      "font_size": 32
    },
    {
      "text": "Δ = -1",
      "x": 452,
      "y": 1440,
      "width": 324.5249343832022,
      "height": 39.36,
      "font_size": 32
    },
    {
      "text": "A worst-case marginal",
      "x": 96,
      "y": 1558,
      "width": 1036.5249343832022,
      "height": 52.89,
      "font_size": 43
    },
    {
      "text": "v<sub>α</sub>(S) = 1[U(M<sub>S</sub>) ≥ α U<sub>full</sub>]",
      "x": 111,
      "y": 1640,
      "width": 1006.5249343832022,
      "height": 63,
      "font_size": 48
    },
    {
      "text": "Δ<sub>i</sub>(S) = v<sub>α</sub>(S <font name=\"PosterMath\">∪</font> {i}) - v<sub>α</sub>(S)",
      "x": 111,
      "y": 1728,
      "width": 1006.5249343832022,
      "height": 59,
      "font_size": 45
    },
    {
      "text": "MinPI<sub>i</sub> = min Δ<sub>i</sub>(S)",
      "x": 111,
      "y": 1817,
      "width": 1006.5249343832022,
      "height": 69,
      "font_size": 55
    },
    {
      "text": "over all S <font name=\"PosterMath\">⊆</font> N <font name=\"PosterMath\">∖</font> {i}; N is the analyzed feature set",
      "x": 111,
      "y": 1893,
      "width": 1006.5249343832022,
      "height": 38.13,
      "font_size": 31
    },
    {
      "text": "-1 harmful",
      "x": 96.0,
      "y": 1976,
      "width": 345.5083114610674,
      "height": 41.82,
      "font_size": 34
    },
    {
      "text": "0 neutral*",
      "x": 441.5083114610674,
      "y": 1976,
      "width": 345.5083114610674,
      "height": 41.82,
      "font_size": 34
    },
    {
      "text": "+1 decisive",
      "x": 787.0166229221348,
      "y": 1976,
      "width": 345.5083114610674,
      "height": 41.82,
      "font_size": 34
    },
    {
      "text": "*Exact values. A sampled 0 or +1 is not a certificate; sampling can miss witnesses.",
      "x": 96,
      "y": 2054,
      "width": 1036.5249343832022,
      "height": 80,
      "font_size": 32
    },
    {
      "text": "Scan to read<br/>the full paper",
      "x": 406,
      "y": 2203,
      "width": 726.5249343832022,
      "height": 108,
      "font_size": 45
    },
    {
      "text": "Theory, experiments<br/>and complete results",
      "x": 406,
      "y": 2336,
      "width": 726.5249343832022,
      "height": 86,
      "font_size": 34
    },
    {
      "text": "hlnks.co/63671101",
