    {
      "text": "01  PROBLEM &amp; METHOD",
      "x": 100,
      "y": 923,
      "width": 1548.7874015748034,
      "height": 66.42,
      "font_size": 54,
      "alignment": "left"
    },
    {
      "text": "Average importance can hide a harmful coalition:<br/>adding a feature can turn an acceptable model into an unacceptable one.",
      "x": 100,
      "y": 1040,
      "width": 1548.7874015748034,
      "height": 110,
      "font_size": 43,
      "alignment": "left"
    },
    {
      "text": "Acceptable",
      "x": 128,
      "y": 1240,
      "width": 430,
      "height": 51.66,
      "font_size": 42,
      "alignment": "center"
    },
    {
      "text": "v(S) = 1",
      "x": 128,
      "y": 1305,
      "width": 430,
      "height": 59.04,
      "font_size": 48,
      "alignment": "center"
    },
    {
      "text": "Unacceptable",
      "x": 1190.7874015748034,
      "y": 1240,
      "width": 430,
      "height": 51.66,
      "font_size": 42,
      "alignment": "center"
    },
    {
      "text": "v(S <font name=\"PosterMath\">∪</font> {i}) = 0",
      "x": 1190.7874015748034,
      "y": 1309,
      "width": 430,
      "height": 52.89,
      "font_size": 43,
      "alignment": "center"
    },
    {
      "text": "+ feature i",
      "x": 575,
      "y": 1228,
      "width": 598.7874015748034,
      "height": 51.66,
      "font_size": 42,
      "alignment": "center"
    },
    {
      "text": "marginal = -1",
      "x": 575,
      "y": 1333,
      "width": 598.7874015748034,
      "height": 47.97,
      "font_size": 39,
      "alignment": "center"
    },
    {
      "text": "THE WORST-CASE MARGINAL",
      "x": 130,
      "y": 1480,
      "width": 1488.7874015748034,
      "height": 41.82,
      "font_size": 34,
      "alignment": "left"
    },
    {
      "text": "v<sub>α</sub>(S) = 1[U(M<sub>S</sub>) ≥ α U<sub>full</sub>]",
      "x": 130,
      "y": 1541,
      "width": 1488.7874015748034,
      "height": 68,
      "font_size": 53,
      "alignment": "left"
    },
    {
      "text": "MinPI<sub>i</sub> = min [v<sub>α</sub>(S <font name=\"PosterMath\">∪</font> {i}) - v<sub>α</sub>(S)]",
      "x": 130,
      "y": 1630,
      "width": 1488.7874015748034,
      "height": 66,
      "font_size": 51,
      "alignment": "left"
    },
    {
      "text": "over S <font name=\"PosterMath\">⊆</font> N <font name=\"PosterMath\">∖</font> {i}; N = analyzed features",
      "x": 130,
      "y": 1711,
      "width": 1488.7874015748034,
      "height": 44.28,
      "font_size": 36,
      "alignment": "left"
    },
    {
      "text": "Validate before removal",
      "x": 100,
      "y": 1801,
      "width": 1548.7874015748034,
      "height": 59.04,
      "font_size": 48,
      "alignment": "left"
    },
    {
      "text": "H: features with an observed -1 marginal on validation data.",
      "x": 100,
      "y": 1871,
      "width": 1548.7874015748034,
      "height": 46.74,
      "font_size": 38,
      "alignment": "left"
    },
    {
      "text": "U<sub>val</sub>(N <font name=\"PosterMath\">∖</font> H) ≥ U<sub>val</sub>(N) - ε",
      "x": 100,
      "y": 1940,
      "width": 1548.7874015748034,
      "height": 66,
      "font_size": 52,
      "alignment": "left"
    },
    {
      "text": "ε = 0.005 (classification); 0.01 (regression).",
      "x": 100,
      "y": 2022,
      "width": 1548.7874015748034,
      "height": 45.51,
      "font_size": 37,
      "alignment": "left"
    },
    {
      "text": "Pass: remove H. Fail: remove nothing. Models fit on training data.",
      "x": 100,
      "y": 2081,
      "width": 1548.7874015748034,
      "height": 45.51,
      "font_size": 37,
      "alignment": "left"
    },
    {
      "text": "Scan to read the full paper",
      "x": 416,
      "y": 2200,
      "width": 1232.7874015748034,
      "height": 60.269999999999996,
      "font_size": 49,
      "alignment": "left"
    },
    {
      "text": "A witnessed -1 certifies harm in one coalition.<br/>Sampling can still miss harmful witnesses.",
