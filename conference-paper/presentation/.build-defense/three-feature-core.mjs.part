// A complete illustrative game connects Voting Game, Shapley and MinPPI.
{
 const s=slide('Voting Game: define the outcome of every feature group');
 text(s,'Illustrative example: D = {x₁, x₂, x₃}, U(D) = 0.90, α = 0.95',60,156,1080,50,26,C.gray);
 text(s,'q = 0.855       v(S) = 1 if U(S) ≥ q, and 0 otherwise',60,219,1080,54,30,C.teal,true);
 table(s,[
 ['Group S','Score U(S)','Outcome v(S)','Group S','Score U(S)','Outcome v(S)'],
 ['∅','0.50','0','{x₁, x₂}','0.84','0'],
 ['{x₁}','0.87','1','{x₁, x₃}','0.89','1'],
 ['{x₂}','0.88','1','{x₂, x₃}','0.86','1'],
 ['{x₃}','0.80','0','{x₁, x₂, x₃}','0.90','1']
 ],[195,150,195,195,150,195],{y:297,h:230,font:23,rowHeights:[46,46,46,46,46]});
 text(s,'“Winning” means meeting the score requirement. This defines the game.',60,551,1080,44,25,C.navy,true);
 text(s,'This game can be nonmonotone: adding an input can change a win into a loss.',60,607,1080,32,21,C.gray);
 note(s);
}
{
 const s=slide('Shapley: average the marginal effects over contexts');
 text(s,'φᵢ(v) = ∑ w(S) Δᵢ(S)       w(S) = |S|! (n − |S| − 1)! / n!',60,158,1080,60,28,C.teal,true);
 text(s,'S excludes i. For n = 3, the four context weights are 1/3, 1/6, 1/6, 1/3.',60,229,1080,30,22,C.gray);
 table(s,[
 ['Input i','Empty group','First one-input group','Second one-input group','Both other inputs'],
 ['x₁','∅: +1','{x₂}: −1','{x₃}: +1','{x₂, x₃}: 0'],
 ['x₂','∅: +1','{x₁}: −1','{x₃}: +1','{x₁, x₃}: 0'],
 ['x₃','∅: 0','{x₁}: 0','{x₂}: 0','{x₁, x₂}: +1']
 ],[145,175,245,245,270],{y:273,h:198,font:21,rowHeights:[54,48,48,48]});
 text(s,'φ₁ = (1/3)(+1) + (1/6)(−1) + (1/6)(+1) + (1/3)(0) = 1/3',60,484,1080,41,26,C.navy);
 text(s,'φ₂ = (1/3)(+1) + (1/6)(−1) + (1/6)(+1) + (1/3)(0) = 1/3',60,530,1080,41,26,C.navy);
 text(s,'φ₃ = (1/3)(0) + (1/6)(0) + (1/6)(0) + (1/3)(+1) = 1/3',60,576,1080,41,26,C.navy);
 text(s,'Cells show context S: marginal Δᵢ(S). Same illustrative game. Shapley (1952), A Value for N-Person Games.',60,624,1050,20,14,C.gray);
 note(s);
}
{
 const s=slide('MinPPI: retain the worst marginal effect');
 text(s,'The game and marginal effects stay the same. The aggregation changes.',60,158,1080,50,27,C.gray);
 text(s,'M₁ = min {+1, −1, +1, 0} = −1',60,230,1080,45,31,C.red,true);
 text(s,'M₂ = min {+1, −1, +1, 0} = −1',60,288,1080,45,31,C.red,true);
 text(s,'M₃ = min {0, 0, 0, +1} = 0',60,346,1080,45,31,C.teal,true);
 table(s,[
 ['Input','Shapley φᵢ','MinPPI Mᵢ','Interpretation in this game'],
 ['x₁','+1/3','−1','Has a harmful context'],
 ['x₂','+1/3','−1','Has a harmful context'],
 ['x₃','+1/3','0','No negative crossing, but can help']
 ],[155,210,210,505],{y:418,h:156,font:23,rowHeights:[39,39,39,39]});
 text(s,'The same positive average can hide different worst-case behavior.',60,587,1080,38,26,C.teal,true);
 note(s);
}
