\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Algorithm~B vs.\ Algorithm~A on Example~2 (500 trials). (a)~Detection rate vs.\ budget $K$: Alg.~B finds the harmful feature at $K=1$ in every trial; Alg.~A needs $K\approx 90$. (b)~Sensitivity to $\mathcal  {N}(0,\sigma ^2)$ noise on $W$: Alg.~B retains $>50\%$ detection at $\sigma =0.50$ vs.\ Alg.~A's $\approx 15\%$.}}{19}{figure.7}\protected@file@percent }
\newlabel{fig:alg_b_vs_a}{{7}{19}{Algorithm~B vs.\ Algorithm~A on Example~2 (500 trials). (a)~Detection rate vs.\ budget $K$: Alg.~B finds the harmful feature at $K=1$ in every trial; Alg.~A needs $K\approx 90$. (b)~Sensitivity to $\mathcal {N}(0,\sigma ^2)$ noise on $W$: Alg.~B retains $>50\%$ detection at $\sigma =0.50$ vs.\ Alg.~A's $\approx 15\%$}{figure.7}{}}
