\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}RQ4: Estimator, Guidance, and Utility Sensitivity}{7}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overview of MinPPI. (a) Exact minimum marginals in the five-feature game of~equation~\ref {eq:constructed-game}: $f_1=-1$ and all other features are neutral at the worst-case level. (b) Geometric detection probabilities for the unique harmful witness under random MC ($p_-=1/30=.0333$) and Algorithm B's perturbation kernel conditional on the oracle seed $\{f_0,f_2\}$ ($\rho =.129$); this isolates the kernel and is not real-data guidance evidence. (c) Held-out evaluations of seed-42 validation-selected fronts for full and gated prefiltered NSGA-II, together with the registered $\alpha \in \{.85,.90,.95,.99\}$ operating points on Madelon and Credit-Card-Fraud. Connecting lines only order the $\alpha $ values and do not assert held-out nondominance.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:overview}{{3}{7}{Overview of MinPPI. (a) Exact minimum marginals in the five-feature game of~\eqref {eq:constructed-game}: $f_1=-1$ and all other features are neutral at the worst-case level. (b) Geometric detection probabilities for the unique harmful witness under random MC ($p_-=1/30=.0333$) and Algorithm B's perturbation kernel conditional on the oracle seed $\{f_0,f_2\}$ ($\rho =.129$); this isolates the kernel and is not real-data guidance evidence. (c) Held-out evaluations of seed-42 validation-selected fronts for full and gated prefiltered NSGA-II, together with the registered $\alpha \in \{.85,.90,.95,.99\}$ operating points on Madelon and Credit-Card-Fraud. Connecting lines only order the $\alpha $ values and do not assert held-out nondominance}{figure.3}{}}
\newlabel{fig:overview@cref}{{[figure][3][]3}{[1][7][]7}{}{}{}}
