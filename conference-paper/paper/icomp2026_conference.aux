\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Algorithm~B vs.\ Algorithm~A on the engineered voting game of Section~\ref {sec:minppi} ($p_-^i=0.033$, 500 trials). (a)~Detection rate vs.\ budget $K$: Algorithm~B deterministically detects the harmful feature at $K=1$; Algorithm~A requires $K \approx 90$. (b)~Robustness to Gaussian noise on the ShapG correlation matrix: even at $\sigma =0.50$, Algorithm~B detects the harmful feature in $>50\%$ of trials, well above uniform sampling.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:alg_b_vs_a}{{2}{8}{Algorithm~B vs.\ Algorithm~A on the engineered voting game of Section~\ref {sec:minppi} ($p_-^i=0.033$, 500 trials). (a)~Detection rate vs.\ budget $K$: Algorithm~B deterministically detects the harmful feature at $K=1$; Algorithm~A requires $K \approx 90$. (b)~Robustness to Gaussian noise on the ShapG correlation matrix: even at $\sigma =0.50$, Algorithm~B detects the harmful feature in $>50\%$ of trials, well above uniform sampling}{figure.2}{}}
