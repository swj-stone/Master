\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Validation-gated matched removal. (a) Descriptive mean descending ranks (1 is best) among all six methods across six retained datasets, computed from each method's five-seed mean $\Delta U$; the full model participates in the ranking but is omitted from the display. (b) Five-seed mean $\Delta U$, where positive values favor removal. Each control uses the accepted MinPPI-matched removal count, and 30 random-matched subset trials are averaged within seed. The display is descriptive and does not establish a broad method ordering.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:removal}{{1}{5}{Validation-gated matched removal. (a) Descriptive mean descending ranks (1 is best) among all six methods across six retained datasets, computed from each method's five-seed mean $\Delta U$; the full model participates in the ranking but is omitted from the display. (b) Five-seed mean $\Delta U$, where positive values favor removal. Each control uses the accepted MinPPI-matched removal count, and 30 random-matched subset trials are averaged within seed. The display is descriptive and does not establish a broad method ordering}{figure.1}{}}
\newlabel{fig:removal@cref}{{[figure][1][]1}{[1][4][]5}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MinPPI removal at $\alpha =.95$ over five seeds. Compression and held-out $\Delta U=U_{\mathrm  {selected}}-U_{\mathrm  {full}}$ are mean $\pm $ sample SD. ``Raw pass'' counts validation-gate passes before backoff, including vacuous passes when no removal was proposed.}}{5}{table.2}\protected@file@percent }
