\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overview of MinPPI. (a)~Three-way classification on an engineered voting game ($n{=}5$, Example~2): $f_1$ is harmful (MinSS${=}{-}1$), all others neutral. (b)~Algorithm~A vs.\ Algorithm~B detection rate vs.\ budget $K$: Algorithm~B achieves deterministic detection at $K{=}1$ ($\approx 38\times $ sample efficiency). (c)~MinPPI $\alpha $ operating points overlaid on NSGA-II-full (gray) and NSGA-II-filtered (blue) Pareto fronts for Madelon and Credit-Card-Fraud (seed 42). All $\alpha $ points lie near preservation${=}1.0$, confirming safety.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:overview}{{3}{10}{Overview of MinPPI. (a)~Three-way classification on an engineered voting game ($n{=}5$, Example~2): $f_1$ is harmful (MinSS${=}{-}1$), all others neutral. (b)~Algorithm~A vs.\ Algorithm~B detection rate vs.\ budget $K$: Algorithm~B achieves deterministic detection at $K{=}1$ ($\approx 38\times $ sample efficiency). (c)~MinPPI $\alpha $ operating points overlaid on NSGA-II-full (gray) and NSGA-II-filtered (blue) Pareto fronts for Madelon and Credit-Card-Fraud (seed 42). All $\alpha $ points lie near preservation${=}1.0$, confirming safety}{figure.3}{}}
\newlabel{fig:overview@cref}{{[figure][3][]3}{[1][9][]10}{}{}{}}
