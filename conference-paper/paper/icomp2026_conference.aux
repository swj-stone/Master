\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces MinPPI trichotomy illustrated on two engineered voting games ($n=5$). (a)~Example~1 with $v_\alpha (S) = \mathbb  {1}[0 \in S]$: feature $f_0$ is decisive ($\text  {MinSS}=+1$); all other features have MinSS~$=0$. (b)~Example~2 with 13 winning coalitions: $f_1$ is harmful ($\text  {MinSS}=-1$) through witness $S = \{f_0, f_2\}$; $f_0$ belongs to every winning coalition yet $\text  {MinSS}(f_0)=0$, refuting the naive equivalence ``in every winning $\Rightarrow $ decisive.'' All MinSS values lie in $\{-1, 0, +1\}$, verifying Property~1.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:minppi_trichotomy}{{1}{6}{MinPPI trichotomy illustrated on two engineered voting games ($n=5$). (a)~Example~1 with $v_\alpha (S) = \mathbb {1}[0 \in S]$: feature $f_0$ is decisive ($\text {MinSS}=+1$); all other features have MinSS~$=0$. (b)~Example~2 with 13 winning coalitions: $f_1$ is harmful ($\text {MinSS}=-1$) through witness $S = \{f_0, f_2\}$; $f_0$ belongs to every winning coalition yet $\text {MinSS}(f_0)=0$, refuting the naive equivalence ``in every winning $\Rightarrow $ decisive.'' All MinSS values lie in $\{-1, 0, +1\}$, verifying Property~1}{figure.1}{}}
\newlabel{fig:minppi_trichotomy@cref}{{[figure][1][]1}{[1][6][]6}{}{}{}}
