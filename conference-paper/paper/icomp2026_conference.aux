\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Algorithm~B vs.\ Algorithm~A on the engineered voting game of Section~\ref {sec:minppi} ($p_-^i=0.033$, 500 trials). (a)~Detection rate vs.\ budget $K$: Algorithm~B deterministically detects the harmful feature at $K=1$; Algorithm~A requires $K \approx 100$. (b)~Robustness to Gaussian noise on the ShapG correlation matrix: even at $\sigma =0.50$, Algorithm~B detects the harmful feature in $>50\%$ of trials, well above uniform sampling.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:alg_b_vs_a}{{3}{9}{Algorithm~B vs.\ Algorithm~A on the engineered voting game of Section~\ref {sec:minppi} ($p_-^i=0.033$, 500 trials). (a)~Detection rate vs.\ budget $K$: Algorithm~B deterministically detects the harmful feature at $K=1$; Algorithm~A requires $K \approx 100$. (b)~Robustness to Gaussian noise on the ShapG correlation matrix: even at $\sigma =0.50$, Algorithm~B detects the harmful feature in $>50\%$ of trials, well above uniform sampling}{figure.3}{}}
\newlabel{fig:alg_b_vs_a@cref}{{[figure][3][]3}{[1][8][]9}{}{}{}}
