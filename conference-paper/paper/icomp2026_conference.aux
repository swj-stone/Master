\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces MinPPI trichotomy on two engineered voting games ($n=5$). (a)~Example~1: $f_0$ decisive ($\text  {MinSS}=+1$). (b)~Example~2: $f_1$ harmful ($\text  {MinSS}=-1$); $f_0$ is in every winning coalition yet $\text  {MinSS}(f_0)=0$, refuting the naive equivalence.}}{17}{figure.5}\protected@file@percent }
\newlabel{fig:minppi_trichotomy}{{5}{17}{MinPPI trichotomy on two engineered voting games ($n=5$). (a)~Example~1: $f_0$ decisive ($\text {MinSS}=+1$). (b)~Example~2: $f_1$ harmful ($\text {MinSS}=-1$); $f_0$ is in every winning coalition yet $\text {MinSS}(f_0)=0$, refuting the naive equivalence}{figure.5}{}}
\newlabel{fig:minppi_trichotomy@cref}{{[figure][5][]5}{[1][17][]17}{}{}{}}
