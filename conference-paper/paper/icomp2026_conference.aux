\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces MOFS pre-filter verification. (a)~HV of NSGA-II-full (gray) vs.\ NSGA-II-filtered (green, 7 datasets, mean $\pm $ std over 5 seeds). Credit-Card shows the largest gain ($+37\%$ HV on 35\% fewer features). Five datasets with $|\mathcal  {H}_{0.95}|{\approx }0$ show identical HV. Madelon trails ($-18\%$), consistent with MinPPI's precision $0.978$ but low recall. (b)~Convergence speed: filtered NSGA-II converges earlier on ISOLET (5 vs.\ 6.2 gen).}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:prefilter}{{3}{10}{MOFS pre-filter verification. (a)~HV of NSGA-II-full (gray) vs.\ NSGA-II-filtered (green, 7 datasets, mean $\pm $ std over 5 seeds). Credit-Card shows the largest gain ($+37\%$ HV on 35\% fewer features). Five datasets with $|\mathcal {H}_{0.95}|{\approx }0$ show identical HV. Madelon trails ($-18\%$), consistent with MinPPI's precision $0.978$ but low recall. (b)~Convergence speed: filtered NSGA-II converges earlier on ISOLET (5 vs.\ 6.2 gen)}{figure.3}{}}
\newlabel{fig:prefilter@cref}{{[figure][3][]3}{[1][8][]10}{}{}{}}
