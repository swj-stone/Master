\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces MinPPI trichotomy illustrated on two engineered voting games ($n=5$). (a)~Example~1 with $v_\alpha (S) = \mathbb  {1}[0 \in S]$: feature $f_0$ is decisive ($\text  {MinSS}=+1$); all other features have MinSS~$=0$. (b)~Example~2 with 13 winning coalitions: $f_1$ is harmful ($\text  {MinSS}=-1$) through witness $S = \{f_0, f_2\}$; $f_0$ belongs to every winning coalition yet $\text  {MinSS}(f_0)=0$, refuting the naive equivalence ``in every winning $\Rightarrow $ decisive.'' All MinSS values lie in $\{-1, 0, +1\}$, verifying Lemma~1.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:minppi_trichotomy}{{1}{7}{MinPPI trichotomy illustrated on two engineered voting games ($n=5$). (a)~Example~1 with $v_\alpha (S) = \mathbb {1}[0 \in S]$: feature $f_0$ is decisive ($\text {MinSS}=+1$); all other features have MinSS~$=0$. (b)~Example~2 with 13 winning coalitions: $f_1$ is harmful ($\text {MinSS}=-1$) through witness $S = \{f_0, f_2\}$; $f_0$ belongs to every winning coalition yet $\text {MinSS}(f_0)=0$, refuting the naive equivalence ``in every winning $\Rightarrow $ decisive.'' All MinSS values lie in $\{-1, 0, +1\}$, verifying Lemma~1}{figure.1}{}}
\newlabel{fig:minppi_trichotomy@cref}{{[figure][1][]1}{[1][7][]7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MinSS and mean Shapley-Shubik values for the two constructed voting games of Figure~\ref {fig:minppi_trichotomy}. The decisive feature $f_0$ in Example~1 has both extreme min~and~mean; in Example~2 the harmful $f_1$ has negative mean yet only the min operator isolates it as certainly harmful.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:minss_demo}{{2}{7}{MinSS and mean Shapley-Shubik values for the two constructed voting games of Figure~\ref {fig:minppi_trichotomy}. The decisive feature $f_0$ in Example~1 has both extreme min~and~mean; in Example~2 the harmful $f_1$ has negative mean yet only the min operator isolates it as certainly harmful}{table.2}{}}
\newlabel{tab:minss_demo@cref}{{[table][2][]2}{[1][7][]7}{}{}{}}
