\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Full versus validation-gated MinPPI-prefiltered NSGA-II under the matched 800-evaluation budget. Bars are five-seed means and whiskers are sample standard deviations for (a) held-out hypervolume of the validation-selected front, using reference point $(1.1,1.1)$, where the dataset-averaged held-out change is +0.016{}, and (b) the post-hoc first evaluation attaining 95\% of that run's final-best validation hypervolume, where lower is earlier. The latter is not a stopping time. No dataset-wise comparison survives the registered exact paired sign-flip tests with within-endpoint Holm correction.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:prefilter}{{2}{6}{Full versus validation-gated MinPPI-prefiltered NSGA-II under the matched 800-evaluation budget. Bars are five-seed means and whiskers are sample standard deviations for (a) held-out hypervolume of the validation-selected front, using reference point $(1.1,1.1)$, where the dataset-averaged held-out change is \NsgaMeanHvChange {}, and (b) the post-hoc first evaluation attaining 95\% of that run's final-best validation hypervolume, where lower is earlier. The latter is not a stopping time. No dataset-wise comparison survives the registered exact paired sign-flip tests with within-endpoint Holm correction}{figure.2}{}}
\newlabel{fig:prefilter@cref}{{[figure][2][]2}{[1][6][]6}{}{}{}}
