\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of MinPPI. (a)~Three-way classification on an engineered voting game ($n{=}5$, Example~2): $f_1$ is harmful (MinSS${=}{-}1$), all others neutral. (b)~Algorithm~A vs.\ Algorithm~B detection rate vs.\ budget $K$ on the same game: Algorithm~B achieves deterministic detection at $K{=}1$ (38$\times $ sample efficiency). (c)~MinPPI $\alpha $ operating points (colored markers) overlaid on NSGA-II-full (gray) and NSGA-II-filtered (blue) Pareto fronts for Madelon and Credit-Card-Fraud (seed 42). All $\alpha $ points lie near preservation${=}1.0$, confirming safety.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:overview}{{2}{9}{Overview of MinPPI. (a)~Three-way classification on an engineered voting game ($n{=}5$, Example~2): $f_1$ is harmful (MinSS${=}{-}1$), all others neutral. (b)~Algorithm~A vs.\ Algorithm~B detection rate vs.\ budget $K$ on the same game: Algorithm~B achieves deterministic detection at $K{=}1$ (38$\times $ sample efficiency). (c)~MinPPI $\alpha $ operating points (colored markers) overlaid on NSGA-II-full (gray) and NSGA-II-filtered (blue) Pareto fronts for Madelon and Credit-Card-Fraud (seed 42). All $\alpha $ points lie near preservation${=}1.0$, confirming safety}{figure.2}{}}
\newlabel{fig:overview@cref}{{[figure][2][]2}{[1][7][]9}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Hypervolume (HV) of NSGA-II-full vs.\ NSGA-II-filtered (mean over 5 seeds, 20 individuals $\times $ 20 generations). $\Delta $HV = filtered $-$ full. NSGA-II-filtered attains higher HV on four of seven datasets despite searching a strictly smaller subspace. Gisette and Abalone show zero harmful features at $\alpha {=}0.95$, so the two methods are identical.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:mofs_prefilter}{{2}{9}{Hypervolume (HV) of NSGA-II-full vs.\ NSGA-II-filtered (mean over 5 seeds, 20 individuals $\times $ 20 generations). $\Delta $HV = filtered $-$ full. NSGA-II-filtered attains higher HV on four of seven datasets despite searching a strictly smaller subspace. Gisette and Abalone show zero harmful features at $\alpha {=}0.95$, so the two methods are identical}{table.2}{}}
\newlabel{tab:mofs_prefilter@cref}{{[table][2][]2}{[1][8][]9}{}{}{}}
