\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces NSGA-II pre-filter verification. (a)~Hypervolume comparison: full (gray) vs.\ MinPPI-filtered (green), 7 datasets, mean $\pm $ std over 5 seeds. Madelon shows the clearest gain ($+11.3\%$). Four datasets with $|\mathcal  {H}|\approx 0$ show identical HV---confirming the ``first, do no harm'' property. (b)~Convergence speed: filtered NSGA-II converges earlier when harmful features are removed.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:prefilter}{{1}{6}{NSGA-II pre-filter verification. (a)~Hypervolume comparison: full (gray) vs.\ MinPPI-filtered (green), 7 datasets, mean $\pm $ std over 5 seeds. Madelon shows the clearest gain ($+11.3\%$). Four datasets with $|\mathcal {H}|\approx 0$ show identical HV---confirming the ``first, do no harm'' property. (b)~Convergence speed: filtered NSGA-II converges earlier when harmful features are removed}{figure.1}{}}
\newlabel{fig:prefilter@cref}{{[figure][1][]1}{[1][5][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces (a)~AUC@10 ranks for 6 methods on 5 classification datasets (Friedman $\chi ^2{=}13.80$, $p{=}0.017$, Kendall's $W{=}0.55$). (b)~AUC@10 heatmap. The Nemenyi CD ($\approx 3.4$ ranks for $k{=}6, N{=}5$) shows no pairwise significant difference---a known limitation of the Dem\v {s}ar procedure at small $N$.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:cd_heatmap}{{2}{6}{(a)~AUC@10 ranks for 6 methods on 5 classification datasets (Friedman $\chi ^2{=}13.80$, $p{=}0.017$, Kendall's $W{=}0.55$). (b)~AUC@10 heatmap. The Nemenyi CD ($\approx 3.4$ ranks for $k{=}6, N{=}5$) shows no pairwise significant difference---a known limitation of the Dem\v {s}ar procedure at small $N$}{figure.2}{}}
\newlabel{fig:cd_heatmap@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
