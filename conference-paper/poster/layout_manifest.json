    },
    {
      "text": "DATASET",
      "x": 2277.0498687664044,
      "y": 1270,
      "width": 310,
      "height": 22.22166874221669,
      "font_size": 30,
      "alignment": "left",
      "max_height": 38,
      "latex": null
    },
    {
      "text": "REMOVED (%)",
      "x": 2607.0498687664044,
      "y": 1270,
      "width": 340,
